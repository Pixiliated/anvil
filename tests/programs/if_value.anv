// `if c { a } else { b }` as a value: one branch is evaluated, of any type. Character literals are
// numbers, as a byte is.
struct Bag {
    name: str,
    items: [i64],
}

enum Shade {
    Dark(level: i64),
    Light,
}

fn sign(n: i64) -> i64 {
    return if n > 0 { 1 } else if n < 0 { -1 } else { 0 };
}

fn pick(c: bool, a: str, b: str) -> str {
    let s: str = if c { a } else { b };
    return s + "!";
}

// Each branch takes its array over, and the other is let go of.
fn longer(a: [i64], b: [i64]) -> [i64] {
    var out: [i64] = if a.len() > b.len() { a } else { b };
    out.push(0);
    return out;
}

fn bag(c: bool) -> Bag {
    return if c { Bag { name: "a", items: [1] } } else { Bag { name: "b", items: [] } };
}

fn shade(n: i64) -> Shade {
    return if n > 5 { Shade.Dark(n) } else { Shade.Light };
}

fn level_of(s: Shade) -> i64 {
    match s {
        Dark(level) => { return level; }
        Light => { return 0; }
    }
}

fn found(c: bool) -> Option[i64] {
    return if c { Some(1) } else { None };
}

fn guarded(xs: [i64], i: i64) -> i64 {
    // Only the chosen branch runs, so this index is not out of bounds.
    return if i < xs.len() { xs[i] } else { -1 };
}

fn class(b: i64) -> str {
    return if b == '*' || b == '_' { "mark" } else if b == '\n' { "line" } else if b == '\'' { "quote" } else { "text" };
}

fn main() uses io {
    print(sign(5));
    print(sign(-5));
    print(sign(0));
    print(pick(c: true, a: "yes", b: "no"));
    print(pick(c: false, a: "yes", b: "no"));
    print(longer(a: [1, 2], b: [3]).len());
    print(longer(a: [1], b: [2, 3, 4]).len());
    print(bag(true).name);
    print(bag(false).items.len());
    print(level_of(shade(7)));
    print(level_of(shade(1)));
    print(guarded(xs: [4], i: 0));
    print(guarded(xs: [4], i: 9));
    print(class('*'));
    print(class('a'));
    print('\t');
    print('"');
}

test "every branch" {
    assert(sign(2) == 1);
    assert(sign(-2) == -1);
    assert(sign(0) == 0);
    assert(pick(c: true, a: "a", b: "b") == "a!");
    assert(pick(c: false, a: "a", b: "b") == "b!");
    assert(longer(a: [1, 2], b: [3]) == [1, 2, 0]);
    assert(longer(a: [], b: [3]) == [3, 0]);
    assert(bag(true).items == [1]);
    assert(bag(false).name == "b");
    assert(level_of(shade(6)) == 6);
    assert(level_of(shade(5)) == 0);
    assert(found(true) == Some(1));
    assert(found(false) == None);
    assert(guarded(xs: [1], i: 0) == 1);
    assert(guarded(xs: [], i: 0) == -1);
    assert(class('_') == "mark");
    assert(class(10) == "line");
    assert(class(39) == "quote");
    assert(class(0) == "text");
}
