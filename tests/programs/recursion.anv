fn fib(n: i64) -> i64
    requires n >= 0
{
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 {
        return a;
    }
    return gcd(a: b, b: a % b);
}

fn is_even(n: i64) -> bool {
    if n == 0 {
        return true;
    }
    return is_odd(n - 1);
}

fn is_odd(n: i64) -> bool {
    if n == 0 {
        return false;
    }
    return is_even(n - 1);
}

fn depth(n: i64) -> i64 {
    if n == 0 {
        return 0;
    }
    return 1 + depth(n - 1);
}

fn main() uses io {
    print(fib(20));
    print(gcd(a: 1071, b: 462));
    print(is_even(10), " ", is_odd(7), " ", is_even(3));
    print(depth(5000));
}
