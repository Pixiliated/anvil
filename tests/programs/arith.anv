fn main() uses io {
    print(1 + 2 * 3);
    print((1 + 2) * 3);
    print("{7 / 2} {-7 / 2} {7 / -2}");
    print("{7 % 3} {-7 % 3} {7 % -3}");
    print(9223372036854775807);
    print(-9223372036854775807 - 1);
    print(2 - 3 - 4);
    print(100 / 10 / 5);
    print(-(-5));
    print("{abs(-12)} {abs(12)}");
    print(1_000_000 * 1_000);
}
