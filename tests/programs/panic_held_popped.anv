// The array got shorter in the loop: the index that was fine before is not any more.

fn main() uses io {
    var a: [i64] = [1, 2, 3];
    var sum: i64 = 0;
    for i in 0..3 {
        print("round {i}");
        let top: i64 = a.pop();
        sum = sum + top + a[1];
    }
    print("never {sum}");
}
