unit m;

enum Shape {
    Circle(radius: f64[m]),
    Rect(width: f64[m], height: f64[m]),
    Label(text: str),
    Empty,
}

enum Light {
    Red,
    Yellow,
    Green,
}

// Recursion goes through an array, which stores its elements separately.
enum Tree {
    Leaf(value: i64),
    Node(name: str, children: [Tree]),
}

struct Drawing {
    title: str,
    shapes: [Shape],
}

fn area(s: Shape) -> f64[m^2] {
    match s {
        Circle(radius) => {
            return 3.0 * radius * radius;
        }
        Rect(width: w, height: h) => {
            return w * h;
        }
        Label(text: _) => {
            return 0.0[m^2];
        }
        Empty => {
            return 0.0[m^2];
        }
    }
}

fn describe(s: Shape) -> str {
    var out: str = "?";
    match s {
        Circle(radius) => {
            out = "circle r={radius}";
        }
        Rect(width, height) => {
            out = "rect {width} x {height}";
        }
        Label(text) => {
            out = "label \"{text}\"";
        }
        Empty => {
            out = "empty";
        }
    }
    return out;
}

fn next(l: Light) -> Light {
    match l {
        Red => {
            return Light.Green;
        }
        Yellow => {
            return Light.Red;
        }
        Green => {
            return Light.Yellow;
        }
    }
}

fn light_name(l: Light) -> str {
    var name: str = "";
    match l {
        Red => {
            name = "red";
        }
        Yellow => {
            name = "yellow";
        }
        Green => {
            name = "green";
        }
    }
    return name;
}

fn total(t: Tree) -> i64 {
    var sum: i64 = 0;
    match t {
        Leaf(value) => {
            sum = value;
        }
        Node(name: _, children) => {
            for c in children {
                sum = sum + total(c);
            }
        }
    }
    return sum;
}

fn names(t: Tree) -> str {
    var out: str = "";
    match t {
        Leaf(value) => {
            out = "{value}";
        }
        Node(name, children) => {
            out = "{name}(";
            var first: bool = true;
            for c in children {
                if !first {
                    out = out + " ";
                }
                out = out + names(c);
                first = false;
            }
            out = out + ")";
        }
    }
    return out;
}

fn main() uses io {
    let shapes: [Shape] = [
        Shape.Circle(2.0[m]),
        Shape.Rect(width: 3.0[m], height: 4.0[m]),
        Shape.Label("hello"),
        Shape.Empty,
    ];
    for s in shapes {
        print("{describe(s)}: area {area(s)}");
    }

    var l: Light = Light.Red;
    for _i in 0..4 {
        print(light_name(l));
        l = next(l);
    }

    let tree: Tree = Tree.Node(name: "root", children: [
        Tree.Leaf(1),
        Tree.Node(name: "kids", children: [Tree.Leaf(2), Tree.Leaf(3)]),
        Tree.Node(name: "none", children: []),
        Tree.Leaf(4),
    ]);
    print("{names(tree)} sums to {total(tree)}");

    var d: Drawing = Drawing { title: "sketch", shapes: [] };
    d.shapes.push(Shape.Label("first"));
    d.shapes.push(Shape.Circle(1.0[m]));
    d.shapes[0] = Shape.Label("renamed");
    let copy: Drawing = d;
    d.shapes[1] = Shape.Empty;
    print("{d.title}: {describe(d.shapes[0])}, {describe(d.shapes[1])}; copy has {describe(copy.shapes[1])}");
}
