// Prints floats across many magnitudes so the C runtime's formatting is compared with the
// interpreter's on hundreds of values.
fn main() uses io {
    var x: f64 = 1.0;
    var y: f64 = 1.0;
    for i in 0..160 {
        x = x * 1.37 + 0.001;
        y = y / 1.91 - 0.0;
        print(i, " ", x, " ", y, " ", -x / 7.0, " ", 1.0 / to_f64(i + 1));
    }
}
