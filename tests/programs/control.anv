fn classify(n: i64) -> str {
    if n < 0 {
        return "negative";
    } else if n == 0 {
        return "zero";
    } else if n < 10 {
        return "small";
    } else {
        return "large";
    }
}

fn first_square_above(limit: i64) -> i64 {
    var i: i64 = 0;
    while true {
        if i * i > limit {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn main() uses io {
    print("{classify(-3)} {classify(0)} {classify(4)} {classify(40)}");
    var total: i64 = 0;
    for i in 0..20 {
        if i % 2 == 0 {
            continue;
        }
        if i > 13 {
            break;
        }
        total = total + i;
    }
    print("odd sum: {total}");
    var pairs: i64 = 0;
    for a in 0..5 {
        for b in a..5 {
            if a + b == 4 {
                pairs = pairs + 1;
            }
        }
    }
    print("pairs: {pairs}");
    print("square: {first_square_above(50)}");
    for _k in 5..2 {
        print("never");
    }
}
