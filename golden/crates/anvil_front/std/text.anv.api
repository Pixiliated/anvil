fn lines(s: str) -> [str]
fn pad_left(s: str, width: i64, fill: str) -> str requires char_count(fill) == 1 steps 2 * abs(width) + 3 * s.len() + 30 allocs 16 * abs(width) + s.len()
fn pad_right(s: str, width: i64, fill: str) -> str requires char_count(fill) == 1 steps 2 * abs(width) + 3 * s.len() + 30 allocs 16 * abs(width) + s.len()
fn repeat(s: str, n: i64) -> str requires n >= 0 steps 2 * n + 4 allocs 8 * n + n * s.len()
fn words(s: str) -> [str] steps 4 * s.len() + 8 allocs 5 * s.len() + 8
