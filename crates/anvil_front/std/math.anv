// The standard library's number functions: `import std.math.{max, floor};`.

pub fn min[T: ordered](a: T, b: T) -> T {
    if b < a {
        return b;
    }
    return a;
}

pub fn max[T: ordered](a: T, b: T) -> T {
    if a < b {
        return b;
    }
    return a;
}

// x, kept between low and high.
pub fn clamp[T: ordered](x: T, low: T, high: T) -> T
    requires !(high < low)
{
    return max(a: low, b: min(a: x, b: high));
}

// base to the power exp; overflow panics, as for *.
pub fn pow(base: i64, exp: i64) -> i64
    requires exp >= 0
{
    var out: i64 = 1;
    for _i in 0..exp {
        out = out * base;
    }
    return out;
}

// The greatest common divisor, never negative; gcd(0, 0) is 0.
pub fn gcd(a: i64, b: i64) -> i64 {
    var x: i64 = abs(a);
    var y: i64 = abs(b);
    while y != 0 {
        let r: i64 = x % y;
        x = y;
        y = r;
    }
    return x;
}

// -1, 0 or 1.
pub fn sign(x: i64) -> i64 {
    if x > 0 {
        return 1;
    }
    if x < 0 {
        return -1;
    }
    return 0;
}

// Floats from 2^52 up have no fraction; nan and the infinities stay as they are.
fn whole(x: f64) -> bool {
    return x != x || abs(x) >= 4503599627370496.0;
}

// The largest whole number not above x.
pub fn floor(x: f64) -> f64 {
    if whole(x) {
        return x;
    }
    let t: f64 = to_f64(to_i64(x));
    if t > x {
        return t - 1.0;
    }
    return t;
}

// The smallest whole number not below x.
pub fn ceil(x: f64) -> f64 {
    if whole(x) {
        return x;
    }
    let t: f64 = to_f64(to_i64(x));
    if t < x {
        return t + 1.0;
    }
    return t;
}

// The nearest whole number; halves go to the even one, as fixed does.
pub fn round(x: f64) -> f64 {
    if whole(x) {
        return x;
    }
    let f: f64 = floor(x);
    let d: f64 = x - f;
    if d > 0.5 {
        return f + 1.0;
    }
    if d < 0.5 {
        return f;
    }
    if floor(f / 2.0) * 2.0 == f {
        return f;
    }
    return f + 1.0;
}

test "min, max and clamp" {
    assert(min(a: 3, b: 2) == 2 && max(a: "a", b: "b") == "b");
    assert(clamp(x: 15, low: 0, high: 10) == 10 && clamp(x: -1.5, low: 0.0, high: 1.0) == 0.0);
    assert(clamp(x: 5, low: 0, high: 10) == 5);
}

test "pow, gcd and sign" {
    assert(pow(base: 2, exp: 10) == 1024 && pow(base: -3, exp: 3) == -27 && pow(base: 7, exp: 0) == 1);
    assert(gcd(a: 84, b: -36) == 12 && gcd(a: 0, b: 0) == 0 && gcd(a: 0, b: 5) == 5);
    assert(sign(-4) == -1 && sign(0) == 0 && sign(9) == 1);
}

test "floor, ceil and round" {
    assert(floor(2.5) == 2.0 && floor(-2.5) == -3.0 && floor(-0.0) == 0.0);
    assert(ceil(2.1) == 3.0 && ceil(-2.9) == -2.0 && ceil(3.0) == 3.0);
    assert(round(2.5) == 2.0 && round(3.5) == 4.0 && round(-2.5) == -2.0 && round(2.4) == 2.0);
    assert(floor(1.0e300) == 1.0e300 && round(0.49999999999999994) == 0.0);
    assert(ceil(1.0e300) == 1.0e300 && round(1.0e300) == 1.0e300 && round(2.6) == 3.0 && round(-2.6) == -3.0);
}

test "floor and ceil are within one of x" for all x: f64 {
    let f: f64 = floor(x);
    assert(f <= x && x - f < 1.0);
    assert(ceil(x) >= x && ceil(x) - x < 1.0);
}
