// The standard library's text functions: `import std.text.{lines, pad_left};`. Widths count
// characters, not bytes.

// How many characters s has: its bytes that do not continue a character (counted without
// making a str of each, as `chars` would).
fn char_count(s: str) -> i64 {
    let b: bytes = s.to_bytes();
    var n: i64 = 0;
    for i in 0..b.len() {
        if (b[i] & 192) != 128 {
            n = n + 1;
        }
    }
    return n;
}

// s with `fill` before it until it is `width` characters wide (s itself when it already is).
allow mutants "at exactly width, n > width and n >= width both give s: fill repeated 0 times adds nothing"
pub fn pad_left(s: str, width: i64, fill: str) -> str
    requires char_count(fill) == 1
    steps 2 * abs(width) + 3 * s.len() + 30
    allocs 16 * abs(width) + s.len()
{
    let n: i64 = char_count(s);
    if n >= width {
        return s;
    }
    return repeat(s: fill, n: width - n) + s;
}

// s with `fill` after it until it is `width` characters wide.
allow mutants "at exactly width, n > width and n >= width both give s: fill repeated 0 times adds nothing"
pub fn pad_right(s: str, width: i64, fill: str) -> str
    requires char_count(fill) == 1
    steps 2 * abs(width) + 3 * s.len() + 30
    allocs 16 * abs(width) + s.len()
{
    let n: i64 = char_count(s);
    if n >= width {
        return s;
    }
    return s + repeat(s: fill, n: width - n);
}

// s, n times: one array of n references to s, joined once, so the bytes made grow with the
// result rather than with its square.
pub fn repeat(s: str, n: i64) -> str
    requires n >= 0
    steps 2 * n + 4
    allocs 8 * n + n * s.len()
{
    var parts: [str] = [];
    for _i in 0..n {
        parts.push(s);
    }
    return parts.join("");
}

// The lines of s, without their "\n" or "\r\n"; a last line without one counts, an empty end
// does not.
pub fn lines(s: str) -> [str] {
    var out: [str] = [];
    if s.len() == 0 {
        return out;
    }
    let parts: [str] = s.split("\n");
    var n: i64 = parts.len();
    if s.ends_with("\n") {
        n = n - 1;
    }
    for i in 0..n {
        var line: str = parts[i];
        if line.ends_with("\r") {
            line = line[0..line.len() - 1];
        }
        out.push(line);
    }
    return out;
}

// The words of s: the pieces between spaces, tabs and line breaks, none empty. One slice of s
// per word: the separators are ASCII, so their byte offsets are character boundaries.
pub fn words(s: str) -> [str]
    steps 4 * s.len() + 8
    allocs 5 * s.len() + 8
{
    let b: bytes = s.to_bytes();
    var out: [str] = [];
    var start: i64 = 0;
    for i in 0..b.len() {
        let c: i64 = b[i];
        if c == 32 || c == 9 || c == 10 || c == 13 {
            if i > start {
                out.push(s[start..i]);
            }
            start = i + 1;
        }
    }
    if b.len() > start {
        out.push(s[start..b.len()]);
    }
    return out;
}

test "padding counts characters" {
    assert(pad_left(s: "7", width: 3, fill: "0") == "007");
    assert(pad_right(s: "é", width: 3, fill: ".") == "é..");
    assert(pad_left(s: "long", width: 2, fill: " ") == "long");
    assert(pad_right(s: "long", width: 2, fill: " ") == "long");
}

test "repeat" {
    assert(repeat(s: "ab", n: 3) == "ababab" && repeat(s: "x", n: 0) == "");
}

test "lines and words" {
    assert(lines("a\nb\r\nc") == ["a", "b", "c"]);
    assert(lines("a\n\nb\n") == ["a", "", "b"]);
    assert(lines("") == []);
    assert(words("  two  words\tand\nmore ") == ["two", "words", "and", "more"]);
    assert(words("one two") == ["one", "two"]);
    assert(words("I saw a b") == ["I", "saw", "a", "b"]);
    assert(words("a\rb\r\nc") == ["a", "b", "c"]);
}

test "joining lines gives the text back" for all xs: [str] {
    var parts: [str] = [];
    for x in xs {
        if !x.contains("\n") {
            parts.push(x);
        }
    }
    var text: str = "";
    for p in parts {
        text = text + p + "\n";
    }
    assert(lines(text) == parts);
}
